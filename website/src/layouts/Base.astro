---
import '../styles/global.css';
import { links, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, image = '/og.png', noindex = false } =
  Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image, site.url).href;

const items = [
  { href: '/work/', label: 'Projects' },
  { href: '/meter/', label: 'METER' },
  { href: '/meow/', label: 'Gallery' },
];

const isActive = (href: string) => path.startsWith(href);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Robotics student, co-founder at METER',
  description,
  address: { '@type': 'PostalAddress', addressLocality: 'Bristol', addressCountry: 'GB' },
  sameAs: [links.github, links.linkedin],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbfbf9" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">Shalev Lau <span>Bristol</span></a>

        <nav class="nav" aria-label="Primary">
          {
            items.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="header-icons">
          <a href={links.github} target="_blank" rel="me noopener" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
          </a>
          <a href={links.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M3.6 1.6a1.7 1.7 0 1 1 0 3.4 1.7 1.7 0 0 1 0-3.4ZM2.2 6.2h2.8V14H2.2V6.2Zm4.6 0h2.7v1.06h.04c.37-.7 1.28-1.44 2.64-1.44 2.82 0 3.34 1.86 3.34 4.27V14h-2.8v-3.47c0-.83-.01-1.9-1.15-1.9-1.16 0-1.34.9-1.34 1.84V14H6.8V6.2Z"
              />
            </svg>
          </a>
          <a href={links.email} aria-label="Email">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <rect x="1.6" y="3.2" width="12.8" height="9.6" rx="1.6" />
              <path d="m2.2 4.4 5.8 4.2 5.8-4.2" />
            </svg>
          </a>
        </div>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <div class="mobile-nav" id="mobile-nav" hidden>
      {items.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={links.email}>Email</a>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <p>© {new Date().getFullYear()} Shalev Lau · {site.location}</p>
        <div class="footer__links">
          <a href={links.email}>Email</a>
          <a href={links.github} target="_blank" rel="me noopener">GitHub</a>
          <a href={links.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
          <a href={links.vcard} download>vCard</a>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.getElementById('mobile-nav');

      const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      toggle?.addEventListener('click', () => {
        if (!menu) return;
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        menu.hidden = open;
      });

      menu?.addEventListener('click', (event) => {
        if (!(event.target as HTMLElement).closest('a')) return;
        toggle?.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      });
    </script>
  </body>
</html>

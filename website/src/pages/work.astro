---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/site';
---

<Base
  title="Projects — Shalev Lau"
  description="Side projects, hackathons and hardware: bird-song ML on Workers, fairness tooling, event systems, live bus data, a taped-out NPU and more."
>
  <header class="page-head wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span>Projects</span>
    </nav>
    <h1>Projects</h1>
    <p>
      Everything I keep coming back to: hackathons, silicon, small tools, and the occasional company.
      Most of it never made it onto the CV.
    </p>
  </header>

  <section class="section wrap" style="padding-top:0">
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>

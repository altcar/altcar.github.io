---
import Base from '../layouts/Base.astro';
import { projects } from '../data/site';

const groups = ['All', 'Venture', 'AI', 'Systems'] as const;
---

<Base
  title="Projects — Shalev Lau"
  description="Nine things I've built: assistive UWB navigation, a vape recycling network, fairness tooling, event systems, browser audio ML and a silicon test chip."
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs reveal" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Projects</span>
      </nav>
      <h1 class="page-hero__title reveal" style="--d:1; margin-top:1rem">
        Everything, <span class="serif">nothing hidden.</span>
      </h1>
      <p class="page-hero__lede reveal" style="--d:2">
        Companies, hackathons, coursework that got out of hand and hardware that had to be taped out.
        Filter by the part of the stack you care about.
      </p>
    </div>
  </section>

  <section class="section section--tight" style="padding-top:0">
    <div class="wrap">
      <div class="filters reveal" role="group" aria-label="Filter projects">
        {
          groups.map((group) => (
            <button
              class="filter"
              type="button"
              data-filter={group}
              aria-pressed={group === 'All' ? 'true' : 'false'}
            >
              {group}
            </button>
          ))
        }
        <span class="filters__count muted" data-count>{projects.length} projects</span>
      </div>

      <div class="card-grid" data-projects>
        {
          projects.map((project, index) => {
            const href = project.detail ?? project.href;
            const isExternal = Boolean(project.href && !project.detail);
            return (
              <article
                class="card glass spotlight reveal"
                style={`--d:${index % 3}`}
                data-group={project.group}
              >
                <div class="card__top">
                  <span class="card__kicker">
                    {project.year} · {project.group}
                  </span>
                  <span class="card__glyph" aria-hidden="true">
                    {project.glyph}
                  </span>
                </div>
                <h2 class="card__title">{project.title}</h2>
                <p class="card__desc">{project.blurb}</p>
                <ul class="tag-list">
                  {project.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
                <div class="card__foot">
                  <span class="card__metric">{project.metric ?? project.kicker}</span>
                  {href ? (
                    <a
                      class="link-arrow"
                      href={href}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener' : undefined}
                      aria-label={`${project.title} — open`}
                    >
                      {project.detail ? 'Case study' : 'Open'}
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path
                          d="M2 10L10 2M10 2H4M10 2V8"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  ) : null}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="contact glass spotlight reveal">
        <p class="eyebrow">More where that came from</p>
        <h2 class="contact__title">The rest lives on <span class="serif">GitHub.</span></h2>
        <p class="lede">
          Coursework, forks and experiments that didn't deserve a card here. The METER case study is the
          one to read first if you want depth.
        </p>
        <div class="contact__row">
          <a class="btn btn--primary" href="https://github.com/altcar" target="_blank" rel="noopener">
            github.com/altcar <span class="btn__arrow">↗</span>
          </a>
          <a class="btn" href="/meter/">METER case study</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .filters {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
  }

  .filter {
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.85rem;
    color: var(--muted);
    transition:
      color 0.25s var(--ease),
      background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .filter:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .filter[aria-pressed='true'] {
    color: #0a0a12;
    background: linear-gradient(120deg, #ffffff, #d8d1ff 70%, #bff6ea);
    border-color: transparent;
    font-weight: 550;
  }

  .filters__count {
    margin-left: auto;
    font-size: 0.82rem;
  }

  .card[hidden] {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
  const count = document.querySelector<HTMLElement>('[data-count]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'All';
      buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));

      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'All' || card.dataset.group === filter;
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (count) count.textContent = `${visible} project${visible === 1 ? '' : 's'}`;
    });
  });
</script>

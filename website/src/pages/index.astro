---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Strip from '../components/Strip.astro';
import { Image } from 'astro:assets';
import { featured, projects, site } from '../data/site';
import { photos } from '../data/photos';

const withImages = projects.filter((project) => project.image);
const stripProjects = withImages.slice(0, 7).map((project) => ({
  src: project.image!,
  alt: project.alt ?? project.title,
}));
const stripPhotos = photos.map((photo) => ({ src: photo.src, alt: photo.alt }));
const teaser = photos.slice(1, 5);
---

<Base title={site.title} description={site.description}>
  <section class="hero wrap">
    <h1 class="hero__title">
      <span>Shalev studies Robotics <span class="soft">@</span> Bristol</span>
      <span class="soft">Co-founder <span class="soft">@</span> METER</span>
      <span class="serif">The rest is off the CV.</span>
    </h1>
    <p class="hero__note">Research and projects at the Bristol Robotics Laboratory.</p>
  </section>

  <div class="strips">
    <Strip items={stripProjects} speed="70s" />
    <Strip items={stripPhotos} reverse speed="85s" />
  </div>

  <section class="section wrap" id="work">
    <div class="section-head">
      <h2>Selected work <span class="count">{featured.length + 1}</span></h2>
      <a href="/work/">All projects →</a>
    </div>

    <a class="feature" href="/meter/">
      <span class="feature__wordmark">METER</span>
      <span class="feature__aside">
        <span class="feature__text">
          Ultra-wideband navigation for blind and low-vision people. Co-founded 2024; I build the
          product and the software.
        </span>
        <span class="feature__link">Case study →</span>
      </span>
    </a>

    <div class="grid">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Field notes</h2>
      <a href="/meow/">Open gallery →</a>
    </div>
    <div class="teaser">
      {
        teaser.map((photo) => (
          <a href="/meow/" aria-label={`${photo.place}, ${photo.note}`}>
            <Image
              src={photo.src}
              alt={photo.alt}
              width={600}
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </section>
</Base>

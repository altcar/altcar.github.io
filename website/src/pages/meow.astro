---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { photos } from '../data/photos';

const shots = await Promise.all(
  photos.map(async (photo, index) => ({
    ...photo,
    index,
    full: await getImage({ src: photo.src, width: 1800, format: 'webp', quality: 82 }),
  })),
);
---

<Base
  title="Gallery — Shalev Lau"
  description="Photos from walks around Bristol, Cornwall and Exeter: the Lizard, Cabot Tower, the harbourside and Clifton Suspension Bridge."
>
  <header class="page-head wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span>Gallery</span>
    </nav>
    <h1>Gallery</h1>
    <p>Walks around Bristol and the West Country. Click any photo for the full size.</p>
  </header>

  <section class="section wrap" style="padding-top:0">
    <div class="gallery">
      {
        shots.map((shot) => (
          <button
            class="shot"
            type="button"
            data-full={shot.full.src}
            data-alt={shot.alt}
            data-caption={`${shot.place} · ${shot.note}`}
            aria-label={`Open photo: ${shot.place}, ${shot.note}`}
          >
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[400, 700, 1000]}
              sizes="(max-width: 720px) 92vw, (max-width: 1000px) 45vw, 30vw"
              format="webp"
              quality={76}
              loading={shot.index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="shot__cap">
              <span>{shot.place}</span>
              <span>{shot.note}</span>
            </span>
          </button>
        ))
      }
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
    <button class="lightbox__close" type="button" aria-label="Close">×</button>
    <img alt="" />
    <p class="lightbox__cap"></p>
  </dialog>
</Base>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = dialog?.querySelector('img');
  const cap = dialog?.querySelector('.lightbox__cap');

  document.querySelectorAll<HTMLElement>('.shot[data-full]').forEach((shot) => {
    shot.addEventListener('click', () => {
      if (!dialog || !img || !cap) return;
      img.src = shot.dataset.full ?? '';
      img.alt = shot.dataset.alt ?? '';
      cap.textContent = shot.dataset.caption ?? '';
      dialog.showModal();
    });
  });

  dialog?.querySelector('.lightbox__close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

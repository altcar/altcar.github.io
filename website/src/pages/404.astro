---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Shalev Lau" description="That page doesn't exist." noindex>
  <section class="page-head wrap" style="padding-bottom:12vh">
    <p class="eyebrow">404</p>
    <h1 style="margin-top:0.6rem">This page moved on.</h1>
    <p>The link is broken, the file was renamed, or the thing was never here.</p>
    <div style="display:flex;gap:16px;margin-top:1.5rem;font-size:13.5px">
      <a href="/" style="border-bottom:1px solid var(--ink)">Home</a>
      <a href="/work/" style="border-bottom:1px solid var(--line-strong)">Projects</a>
      <a href="/meow/" style="border-bottom:1px solid var(--line-strong)">Gallery</a>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Shalev Lau" description="That page doesn't exist." noindex>
  <section class="section" style="padding-top: calc(var(--nav-h) + 14vh); padding-bottom: 14vh">
    <div class="wrap">
      <p class="eyebrow reveal">404</p>
      <h1 class="page-hero__title reveal" style="--d:1; margin-top:1rem">
        This page <span class="serif">moved on.</span>
      </h1>
      <p class="page-hero__lede reveal" style="--d:2">
        The link is broken, the file was renamed, or the thing was never here. The good stuff is a click
        away.
      </p>
      <div class="hero__cta reveal" style="--d:3">
        <a class="btn btn--primary" href="/">Back home <span class="btn__arrow">→</span></a>
        <a class="btn" href="/work/">All projects</a>
        <a class="btn" href="/meow/">Gallery</a>
      </div>
    </div>
  </section>
</Base>

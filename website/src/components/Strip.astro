---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; alt: string }[];
  reverse?: boolean;
  speed?: string;
}

const { items, reverse = false, speed = '90s' } = Astro.props;
---

<div class:list={['strip', { 'strip--reverse': reverse }]} style={`--speed:${speed}`} aria-hidden="true">
  <div class="strip__track">
    {
      [0, 1].map(() => (
        <div class="strip__group">
          {items.map((item) => (
            <div class="tile">
              <Image
                src={item.src}
                alt={item.alt}
                widths={[360, 560]}
                sizes="380px"
                format="webp"
                quality={72}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

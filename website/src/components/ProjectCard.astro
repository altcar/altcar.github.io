---
import { Image } from 'astro:assets';
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = project.detail ?? project.href;
const external = Boolean(project.href && !project.detail);
const target = external ? '_blank' : undefined;
const rel = external ? 'noopener' : undefined;
---

<article class="project">
  {
    project.image && (
      <a class="project__media" href={href} target={target} rel={rel} tabindex="-1" aria-hidden="true">
        <Image
          src={project.image}
          alt=""
          widths={[420, 720, 1000]}
          sizes="(max-width: 720px) 92vw, (max-width: 1100px) 46vw, 340px"
          format="webp"
          quality={78}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="project__body">
    <h3 class="project__title">
      <a href={href} target={target} rel={rel}>{project.title}</a>
      <span class="project__year">{project.year}</span>
    </h3>
    <p class="project__desc">{project.summary}</p>
    <ul class="project__tags">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>

<svg viewBox="0 0 560 560" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="mv-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9b8cff" stop-opacity="0.85" />
      <stop offset="1" stop-color="#5ee7c6" stop-opacity="0.15" />
    </linearGradient>
    <linearGradient id="mv-glass" x1="0" y1="0" x2="0.7" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.2" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.03" />
    </linearGradient>
    <radialGradient id="mv-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#6f5cff" stop-opacity="0.5" />
      <stop offset="1" stop-color="#6f5cff" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx="280" cy="288" r="250" fill="url(#mv-glow)" />

  <g fill="none" stroke="url(#mv-ring)">
    <circle cx="280" cy="288" r="86" stroke-width="1.3" />
    <circle cx="280" cy="288" r="152" stroke-width="1.1" stroke-dasharray="2 10" opacity="0.75" />
    <circle cx="280" cy="288" r="218" stroke-width="1" stroke-dasharray="1 14" opacity="0.45" />
  </g>

  <g stroke="#ffffff" stroke-opacity="0.18" stroke-width="1">
    <line x1="280" y1="40" x2="280" y2="66" />
    <line x1="280" y1="510" x2="280" y2="536" />
    <line x1="32" y1="288" x2="58" y2="288" />
    <line x1="502" y1="288" x2="528" y2="288" />
  </g>

  <!-- dashed ranges out to the anchors -->
  <g stroke="#9b8cff" stroke-opacity="0.55" stroke-width="1" stroke-dasharray="3 7" fill="none">
    <path d="M280 288 L150 166" />
    <path d="M280 288 L432 214" />
    <path d="M280 288 L330 446" />
  </g>

  <!-- anchors -->
  <g>
    <g transform="translate(150 166)">
      <rect x="-13" y="-13" width="26" height="26" rx="8" fill="url(#mv-glass)" stroke="#ffffff" stroke-opacity="0.35" />
      <circle r="3" fill="#5ee7c6" />
    </g>
    <g transform="translate(432 214)">
      <rect x="-13" y="-13" width="26" height="26" rx="8" fill="url(#mv-glass)" stroke="#ffffff" stroke-opacity="0.35" />
      <circle r="3" fill="#5ee7c6" />
    </g>
    <g transform="translate(330 446)">
      <rect x="-13" y="-13" width="26" height="26" rx="8" fill="url(#mv-glass)" stroke="#ffffff" stroke-opacity="0.35" />
      <circle r="3" fill="#5ee7c6" />
    </g>
  </g>

  <!-- the tag -->
  <g transform="translate(280 288)">
    <circle r="26" fill="#0a0a12" fill-opacity="0.7" stroke="#ffffff" stroke-opacity="0.22" />
    <circle r="15" fill="none" stroke="#ffffff" stroke-opacity="0.5" stroke-width="1.2" />
    <circle r="6" fill="#ffffff" />
    <circle r="42" fill="none" stroke="#ffffff" stroke-opacity="0.22" stroke-width="1" />
  </g>

  <!-- floating reading card -->
  <g transform="translate(48 380)">
    <rect width="196" height="98" rx="18" fill="url(#mv-glass)" stroke="#ffffff" stroke-opacity="0.22" />
    <g fill="#ffffff" fill-opacity="0.85">
      <rect x="18" y="24" width="60" height="7" rx="3.5" />
    </g>
    <g fill="#9b8cff">
      <rect x="18" y="46" width="120" height="9" rx="4.5" opacity="0.9" />
      <rect x="18" y="64" width="76" height="9" rx="4.5" opacity="0.55" />
    </g>
    <circle cx="168" cy="34" r="5" fill="#5ee7c6" />
  </g>

  <!-- second small card -->
  <g transform="translate(356 74)">
    <rect width="150" height="66" rx="16" fill="url(#mv-glass)" stroke="#ffffff" stroke-opacity="0.22" />
    <g fill="#5ee7c6">
      <rect x="16" y="18" width="84" height="8" rx="4" opacity="0.85" />
    </g>
    <g fill="#ffffff" fill-opacity="0.35">
      <rect x="16" y="38" width="52" height="7" rx="3.5" />
    </g>
  </g>
</svg>
